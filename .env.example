# ==========================================
# LangSmith Observability & Tracing Config
# ==========================================

# Enable/disable LangSmith tracing (true/false)
LANGSMITH_TRACING=true

# LangSmith API endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key - Get from: https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=lsv_<your-api-key-here>

# LangSmith project name for organizing traces
LANGSMITH_PROJECT=agents-pronunciation

# ==========================================
# Azure Speech Services Config
# ==========================================

AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=eastus

# ==========================================
# OpenAI Config
# ==========================================

OPENAI_API_KEY=sk-<your-openai-api-key>

# ==========================================
# Database Config
# ==========================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/agents_db
PG_URI=postgresql://user:password@localhost:5432/agents_db

# Read-only connection to the BE (Java) "Vox" database -- used only by
# spikes/derive_voice_live_unit_price.py to sum ai_usage_record.duration_ms. Separate DB from
# agents_db above, typically same Postgres server.
VOX_BE_DATABASE_URL=postgresql://user:password@localhost:5432/Vox

# ==========================================
# Azure Cost Management (control-plane, read-only)
# ==========================================

# App Registration credentials with "Cost Management Reader" role on the subscription -- used only
# by spikes/derive_voice_live_unit_price.py, separate from AZURE_SPEECH_KEY above (data-plane).
AZURE_TENANT_ID=<your-azure-ad-tenant-id>
AZURE_CLIENT_ID=<app-registration-application-id>
AZURE_CLIENT_SECRET=<app-registration-client-secret>
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>

# ==========================================
# RabbitMQ Config (Message Broker)
# ==========================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ==========================================
# Chroma Vector DB Config
# ==========================================

CHROMA_COLLECTION_NAME=pronunciation-vectors
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==========================================
# Application Config
# ==========================================

LOG_LEVEL=INFO
ENVIRONMENT=development

# WebRTC ICE
# Leave TURN_URL empty to use STUN only. Fill all TURN_* values after coturn is deployed.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ==========================================
# vox-streaming gRPC Alert Config
# ==========================================

VOX_STREAMING_GRPC_ADDR=localhost:9091
VOX_STREAMING_API_KEY=

# ==========================================
# Java (vox) internal practice-session API
# ==========================================

VOX_JAVA_BASE_URL=http://localhost:8080
# Must match vox/.env's PRACTICE_INTERNAL_SECRET exactly.
PRACTICE_INTERNAL_SECRET=
